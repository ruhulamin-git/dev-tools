{
	"name": "devxhub-tools",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"audit": "pnpm audit --prod",
		"ci": "pnpm lint && pnpm check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/codemirror": "^5.60.18",
		"@types/node": "^26.6.4",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"shadcn-svelte": "1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"esbuild"
		],
		"overrides": {
			"dompurify": ">=3.4.8",
			"fflate": ">=0.8.3",
			"socket.io-parser": ">=4.2.7",
			"cookie@^0.6.0": "0.7.2",
			"picomatch": ">=4.0.4",
			"yaml@1": ">=1.10.3",
			"postcss": ">=8.5.28",
			"nanoid@<4": ">=3.3.19",
			"@humanfs/node": ">=0.16.8",
			"postcss-selector-parser": ">=7.1.3"
		}
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.13",
		"@fontsource/instrument-serif": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"cron-parser": "^5.10.1",
		"cronstrue": "^3.27.0",
		"exifr": "^7.1.3",
		"file-saver": "^2.0.5",
		"html2pdf.js": "^0.14.0",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.2",
		"qrcode": "^1.5.4",
		"rehype-prism-plus": "^2.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"socket.io-client": "^4.8.4",
		"spark-md5": "^3.0.2",
		"svelte-codemirror-editor": "^2.1.0",
		"tailwind-merge": "^3.7.0",
		"unified": "^11.0.5"
	},
	"packageManager": "pnpm@10.34.5"
}
